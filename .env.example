# Copy to .env and fill in real values. .env is already gitignored — never commit it.

# --- Postgres (db service) ---
POSTGRES_USER=mouse_tracker
POSTGRES_PASSWORD=
POSTGRES_DB=mouse_tracker_prod

# --- Phoenix (app service) ---
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=
# Hostname or IP the app is reached at (used for URL generation, e.g. magic-link emails).
# Must match the site address in ./Caddyfile — Caddy issued its cert for that exact value.
PHX_HOST=
PORT=4000

# FORCE_SSL is hardcoded to "true" in docker-compose.yml (not read from here) — Caddy
# terminates TLS with a self-signed cert from its own internal CA (LAN-only VM, no public
# DNS/port-80 reachability for Let's Encrypt) and forwards X-Forwarded-Proto.

# Each video_processing job shells out to a Python/OpenCV subprocess that can use a
# full CPU core for its duration — keep this at or below the VM's free core count.
OBAN_VIDEO_PROCESSING_CONCURRENCY=4

# --- Mailer (SMTP) — required, registration/magic-link login send real emails ---
# Any SMTP provider works: Gmail (use an App Password, not your normal password),
# Amazon SES SMTP credentials, Mailgun SMTP, a self-hosted relay, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false
